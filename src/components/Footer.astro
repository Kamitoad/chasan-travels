---
import { SITE_AUTHOR, SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	<div class="footer-content">
		<div>
			<p class="wordmark">{SITE_TITLE}</p>
			<p>&copy; {today.getFullYear()} {SITE_AUTHOR}</p>
		</div>
		<nav aria-label="Fußnavigation">
			<a href="/blog">Journal</a>
			<a href="/about">Über</a>
			<a href="/credits">Bildnachweise</a>
			<a href="/rss.xml">RSS Feed</a>
			<a href="/impressum">Impressum</a>
			<a href="/datenschutz">Datenschutz</a>
		</nav>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--color-border-dark);
		padding: 3rem var(--page-gutter) 4rem;
		background: var(--color-ink);
		color: #abb5b1;
		font-size: 0.9rem;
	}
	.footer-content {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		width: min(100%, var(--content-wide));
		margin-inline: auto;
	}
	p {
		margin: 0;
	}
	.wordmark {
		margin-bottom: 0.25rem;
		color: var(--color-paper-light);
		font-family: var(--font-display);
		font-size: 1.75rem;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 1.5rem;
	}
	a {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		color: var(--color-paper-light);
	}
	@media (max-width: 520px) {
		.footer-content {
			align-items: flex-start;
			flex-direction: column;
			gap: 1.5rem;
		}
		nav {
			justify-content: flex-start;
			gap: 0.5rem 1.5rem;
		}
	}
</style>
