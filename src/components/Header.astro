---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="Hauptnavigation">
		<a class="brand" href="/" aria-label={`${SITE_TITLE}, Startseite`}>
			<img class="brand-mark" src="/favicon.svg" alt="" width="48" height="48" />
			<span class="brand-copy">
				<strong>{SITE_TITLE}</strong>
				<small>Reisen · Geschichten · Erinnerungen</small>
			</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Start</HeaderLink>
			<HeaderLink href="/blog">Journal</HeaderLink>
			<HeaderLink href="/about">Über</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		position: relative;
		z-index: 50;
		border-bottom: 1px solid var(--color-border-dark);
		background: var(--color-ink);
	}
	nav {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		width: min(calc(100% - 2 * var(--page-gutter)), var(--content-wide));
		min-height: 5rem;
		margin-inline: auto;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		width: fit-content;
		color: var(--color-paper-light);
		text-decoration: none;
	}
	.brand-mark {
		flex: none;
		width: 3rem;
		height: 3rem;
	}
	.brand-copy {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
	}
	.brand strong {
		font-family: var(--font-display);
		font-size: 1.6rem;
		font-weight: 400;
		letter-spacing: -0.035em;
		white-space: nowrap;
	}
	.brand small {
		color: #b7c0bc;
		font-family: var(--font-meta);
		font-size: 0.62rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		white-space: nowrap;
	}
	.internal-links {
		display: flex;
		gap: clamp(0.25rem, 2vw, 1rem);
	}
	.internal-links :global(a) {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		border-bottom: 1px solid transparent;
		padding-inline: 0.55rem;
		color: #cbd1ce;
		font-size: 0.85rem;
		text-decoration: none;
	}
	.internal-links :global(a:hover),
	.internal-links :global(a.active) {
		border-bottom-color: var(--color-focus);
		color: var(--color-paper-light);
	}
	@media (max-width: 720px) {
		nav {
			grid-template-columns: 1fr;
			gap: 0.3rem;
			padding-block: 0.7rem 0.35rem;
		}
		.brand {
			align-items: center;
			gap: 0.5rem;
		}
		.brand-mark {
			width: 2.75rem;
			height: 2.75rem;
		}
		.brand-copy small {
			display: none;
		}
		.internal-links {
			justify-content: space-between;
		}
		.internal-links :global(a) {
			padding-inline: 0;
		}
	}
</style>
