---
interface Props {
	date: Date;
	language?: 'de' | 'en';
}

const { date, language = 'de' } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString(language === 'en' ? 'en-CA' : 'de-DE', {
			year: 'numeric',
			month: 'long',
			day: 'numeric',
			timeZone: 'UTC',
		})
	}
</time>
