---
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import '../styles/global.css';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	language?: 'de' | 'en';
	alternatePath?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const { title, description, image, language = 'de', alternatePath } = Astro.props;
const feedPath = language === 'en' ? 'en/rss.xml' : 'rss.xml';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#101917" />

<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL(feedPath, Astro.site ?? Astro.url.origin)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<link rel="canonical" href={canonicalURL} />
{
	alternatePath && (
		<link
			rel="alternate"
			hreflang={language === 'en' ? 'de' : 'en'}
			href={new URL(alternatePath, Astro.site ?? Astro.url.origin)}
		/>
	)
}

<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={new URL(image.src, Astro.site ?? Astro.url.origin)} />}

<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
