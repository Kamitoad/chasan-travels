---
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={`${title} · Chasan Travels`} description={description}>
	<main id="main-content" class="legal-page">
		<header>
			<p class="eyebrow">Rechtliches</p>
			<h1>{title}</h1>
		</header>
		<article class="legal-copy">
			<slot />
		</article>
	</main>
</BaseLayout>

<style>
	.legal-page {
		width: min(calc(100% - 2 * var(--page-gutter)), var(--content-wide));
		margin-inline: auto;
		padding-block: clamp(3.5rem, 8vw, 7rem);
	}
	header {
		border-bottom: 1px solid var(--color-border);
		padding-bottom: clamp(2rem, 5vw, 4rem);
	}
	h1 {
		max-width: 16ch;
		margin-top: 1rem;
		font-size: clamp(2.8rem, 7vw, 6rem);
		letter-spacing: -0.045em;
	}
	.legal-copy {
		max-width: var(--content-reading);
		padding-top: clamp(2.5rem, 6vw, 5rem);
	}
	.legal-copy :global(h2) {
		margin-block: 3.5rem 1.25rem;
	}
	.legal-copy :global(h2:first-child) {
		margin-top: 0;
	}
	.legal-copy :global(h3) {
		margin-block: 2.25rem 0.85rem;
	}
	.legal-copy :global(h4) {
		margin-block: 1.75rem 0.65rem;
		font-family: var(--font-atkinson), system-ui, sans-serif;
		font-size: 1.05rem;
		line-height: 1.4;
	}
	.legal-copy :global(ul) {
		padding-left: 1.4rem;
	}
	.legal-copy :global(.legal-address) {
		font-style: normal;
	}
	.legal-copy :global(.legal-source) {
		margin-top: 3.5rem;
		font-size: 0.9rem;
	}
	.legal-copy :global(.all-caps) {
		font-weight: 700;
	}
</style>
