---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { CURRENT_CHAPTER, SITE_TITLE } from '../consts';
import BaseLayout from './BaseLayout.astro';

type PostData = CollectionEntry<'blog'>['data'];
interface Props extends PostData {
	entryNumber: number;
	readingMinutes: number;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	location,
	tags,
	draft,
	heroImage,
	heroImageAlt,
	heroImageCaption,
	heroImageCredit,
	heroImageCreditUrl,
	entryNumber,
	readingMinutes,
	language,
} = Astro.props;
const en = language === 'en';
const blogPath = en ? '/en/blog/' : '/blog/';
---

<BaseLayout title={`${title} · ${SITE_TITLE}`} description={description} image={heroImage}>
	<main id="main-content">
		<article>
			<header class="post-header">
				<a class="back-link" href={blogPath}><span aria-hidden="true">←</span> Journal</a>
				<p class="entry-label">
					{en ? 'Westward' : CURRENT_CHAPTER.title} · {en ? 'Entry' : 'Eintrag'}
					{String(entryNumber).padStart(2, '0')}
				</p>
				<h1>{title}</h1>
				<p class="description">{description}</p>
				<div class="meta">
					<span><FormattedDate date={pubDate} language={language} /></span>
					{location && <span>{location}</span>}
					<span>{readingMinutes} {en ? 'min read' : 'Min. Lesezeit'}</span>
					{draft && <strong>{en ? 'Draft · not public' : 'Entwurf · nicht öffentlich'}</strong>}
				</div>
			</header>

			{
				heroImage && heroImageAlt && (
					<figure class="hero-image">
						<Image
							src={heroImage}
							alt={heroImageAlt}
							widths={[640, 960, 1440, 1920]}
							sizes="100vw"
						/>
						{(heroImageCaption || heroImageCredit) && (
							<figcaption>
								{heroImageCaption && <span>{heroImageCaption}</span>}
								{heroImageCredit &&
									(heroImageCreditUrl ? (
										<a href={heroImageCreditUrl}>{heroImageCredit}</a>
									) : (
										<span>{heroImageCredit}</span>
									))}
							</figcaption>
						)}
					</figure>
				)
			}

			<div class="prose">
				<slot />
				{
					updatedDate && (
						<p class="last-updated-on">
							{en ? 'Last updated on' : 'Zuletzt aktualisiert am'}{' '}
							<FormattedDate date={updatedDate} language={language} />
						</p>
					)
				}
			</div>

			<footer class="post-footer">
				<div>
					<p class="eyebrow">{en ? 'Filed under' : 'Abgelegt unter'}</p>
					{
						tags.length > 0 ? (
							<ul aria-label={en ? 'Tags' : 'Schlagwörter'}>
								{tags.map((tag) => (
									<li>#{tag}</li>
								))}
							</ul>
						) : (
							<p>Journal</p>
						)
					}
				</div>
				<a href={blogPath}
					>{en ? 'All entries' : 'Alle Einträge'} <span aria-hidden="true">→</span></a
				>
			</footer>
		</article>
	</main>
</BaseLayout>

<style>
	.post-header {
		width: min(calc(100% - 2 * var(--page-gutter)), var(--content-wide));
		margin-inline: auto;
		padding-block: clamp(3.5rem, 9vw, 7rem);
	}
	.back-link {
		display: inline-flex;
		gap: 0.5rem;
		align-items: center;
		min-height: 2.75rem;
		margin-bottom: clamp(3rem, 8vw, 6rem);
		font-weight: 700;
	}
	.entry-label,
	.meta {
		font-family: var(--font-meta);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.entry-label {
		margin: 0 0 1rem;
		color: var(--color-accent-dark);
		font-weight: 700;
	}
	h1 {
		max-width: 13ch;
		font-size: clamp(3.25rem, 9vw, 7.5rem);
		letter-spacing: -0.055em;
		line-height: 0.9;
		text-wrap: balance;
	}
	.description {
		max-width: 48rem;
		margin: 2rem 0 0;
		color: var(--color-text-muted);
		font-family: var(--font-display);
		font-size: clamp(1.3rem, 2.7vw, 2rem);
		line-height: 1.35;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem 1.5rem;
		margin-top: 2.5rem;
		color: var(--color-text-muted);
	}
	.meta strong {
		border-bottom: 2px solid var(--color-accent);
		color: var(--color-accent-dark);
	}
	.hero-image {
		margin: 0;
		background: var(--color-ink);
	}
	.hero-image :global(img) {
		display: block;
		width: 100%;
		max-height: 80vh;
		object-fit: cover;
	}
	figcaption {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		width: min(calc(100% - 2 * var(--page-gutter)), var(--content-wide));
		margin-inline: auto;
		padding-block: 0.8rem;
		color: #b8c1bd;
		font-size: 0.75rem;
	}
	figcaption a {
		color: var(--color-paper-light);
	}
	.prose {
		width: min(calc(100% - 2 * var(--page-gutter)), var(--content-reading));
		margin-inline: auto;
		padding-block: clamp(4rem, 9vw, 7rem);
		font-size: clamp(1.05rem, 1.6vw, 1.18rem);
	}
	.prose > :global(p:first-child)::first-letter {
		float: left;
		margin: 0.12em 0.12em 0 0;
		color: var(--color-accent-dark);
		font-family: var(--font-display);
		font-size: 4.4em;
		line-height: 0.72;
	}
	.prose :global(h2),
	.prose :global(h3) {
		text-wrap: balance;
	}
	.prose :global(h2) {
		font-size: clamp(2rem, 4vw, 3.15rem);
	}
	.prose :global(a) {
		font-weight: 700;
	}
	.prose :global(p:has(> img:only-child)) {
		margin-block: clamp(2.5rem, 7vw, 4.5rem) 0.75rem;
	}
	.prose :global(p > img:only-child) {
		display: block;
		width: 100%;
		border: 1px solid var(--color-border);
		background: var(--color-ink-soft);
	}
	.prose :global(p:has(> img:only-child) + p:has(> em:only-child)) {
		margin-bottom: clamp(2.5rem, 7vw, 4.5rem);
		color: var(--color-text-muted);
		font-family: var(--font-meta);
		font-size: 0.75rem;
		font-style: normal;
		letter-spacing: 0.02em;
		line-height: 1.55;
	}
	.prose :global(p:has(> img:only-child) + p > em:only-child) {
		font-style: normal;
	}
	.last-updated-on {
		border-top: 1px solid var(--color-border);
		margin-top: 3rem;
		padding-top: 1rem;
		color: var(--color-text-muted);
		font-size: 0.85rem;
	}
	.post-footer {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
		width: min(calc(100% - 2 * var(--page-gutter)), var(--content-wide));
		margin-inline: auto;
		border-top: 1px solid var(--color-border);
		padding-block: 2rem 5rem;
	}
	.post-footer ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 0.6rem 0 0;
		padding: 0;
		color: var(--color-text-muted);
		list-style: none;
	}
	.post-footer > a {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font-weight: 700;
	}
	@media (max-width: 600px) {
		figcaption,
		.post-footer {
			align-items: flex-start;
			flex-direction: column;
		}
		.hero-image :global(img) {
			min-height: 55vh;
			object-position: 24% center;
		}
	}
</style>
