---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Bildnachweise · Chasan Moustafa"
	description="Quellen und Lizenzen der verwendeten Bilder."
>
	<main id="main-content" class="credits">
		<header>
			<p class="eyebrow">Transparenz</p>
			<h1>Bildnachweise</h1>
			<p>Bilder ohne eigenen Urhebervermerk werden auf dieser Seite vollständig zugeordnet.</p>
		</header>

		<section aria-labelledby="vancouver-photo">
			<p class="number">01</p>
			<div>
				<h2 id="vancouver-photo">Vancouver Harbour</h2>
				<p>
					Foto von <a
						href="https://commons.wikimedia.org/wiki/File:Vancouver_harbour_skyline_(44723845851).jpg"
						lang="en">dronepicr</a
					>. Veröffentlicht unter <a href="https://creativecommons.org/licenses/by/2.0/deed.de"
						>CC BY 2.0</a
					>.
				</p>
				<p>
					Die lokale Datei wurde für die Webdarstellung komprimiert. Nicht sichtbare Metadaten
					wurden entfernt.
				</p>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.credits {
		width: min(calc(100% - 2 * var(--page-gutter)), var(--content-wide));
		margin-inline: auto;
		padding-block: clamp(4rem, 9vw, 8rem);
	}
	header {
		max-width: 52rem;
		margin-bottom: clamp(4rem, 9vw, 7rem);
	}
	h1 {
		margin-top: 1rem;
		font-size: clamp(3.5rem, 10vw, 7.5rem);
		letter-spacing: -0.055em;
	}
	header > p:last-child {
		max-width: 40rem;
		margin-top: 1.5rem;
		color: var(--color-text-muted);
	}
	section {
		display: grid;
		grid-template-columns: 4rem minmax(0, 1fr);
		gap: clamp(1.5rem, 5vw, 5rem);
		border-block: 1px solid var(--color-border);
		padding-block: 2rem;
	}
	.number {
		margin: 0;
		color: var(--color-accent-dark);
		font-family: var(--font-meta);
		font-size: 0.75rem;
		font-weight: 700;
	}
	h2 {
		font-size: clamp(2rem, 4vw, 3rem);
	}
	section div p {
		max-width: 45rem;
		margin-top: 1rem;
		color: var(--color-text-muted);
	}
	@media (max-width: 520px) {
		section {
			grid-template-columns: 1fr;
		}
	}
</style>
