---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
	language?: 'de' | 'en';
}

const { language = 'de' } = Astro.props;
const en = language === 'en';
---

<BaseLayout
	title={en ? 'Photo credits · Chasan Moustafa' : 'Bildnachweise · Chasan Moustafa'}
	description={en
		? 'Information about the photos used on Chasan Travels.'
		: 'Quellen und Lizenzen der verwendeten Bilder.'}
>
	<main id="main-content" class="credits">
		<header>
			<p class="eyebrow">{en ? 'Transparency' : 'Transparenz'}</p>
			<h1>{en ? 'Photo credits' : 'Bildnachweise'}</h1>
			<p>
				{
					en
						? 'The photos currently published on this website are my own.'
						: 'Die derzeit auf dieser Website veröffentlichten Fotos sind eigene Aufnahmen.'
				}
			</p>
		</header>

		<section aria-labelledby="photo-credits">
			<p class="number">01</p>
			<div>
				<h2 id="photo-credits">{en ? 'My own photos' : 'Eigene Fotos'}</h2>
				<p>
					{
						en
							? 'The photographs in the travel stories and on the home page were taken by Chasan Moustafa. Individual captions provide context for each image.'
							: 'Die Fotografien in den Reisebeiträgen und auf der Startseite stammen von Chasan Moustafa. Bildunterschriften geben zusätzliche Informationen zu den einzelnen Aufnahmen.'
					}
				</p>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.credits {
		width: min(calc(100% - 2 * var(--page-gutter)), var(--content-wide));
		margin-inline: auto;
		padding-block: clamp(4rem, 9vw, 8rem);
	}
	header {
		max-width: 52rem;
		margin-bottom: clamp(4rem, 9vw, 7rem);
	}
	h1 {
		margin-top: 1rem;
		font-size: clamp(3.5rem, 10vw, 7.5rem);
		letter-spacing: -0.055em;
	}
	header > p:last-child {
		max-width: 40rem;
		margin-top: 1.5rem;
		color: var(--color-text-muted);
	}
	section {
		display: grid;
		grid-template-columns: 4rem minmax(0, 1fr);
		gap: clamp(1.5rem, 5vw, 5rem);
		border-block: 1px solid var(--color-border);
		padding-block: 2rem;
	}
	.number {
		margin: 0;
		color: var(--color-accent-dark);
		font-family: var(--font-meta);
		font-size: 0.75rem;
		font-weight: 700;
	}
	h2 {
		font-size: clamp(2rem, 4vw, 3rem);
	}
	section div p {
		max-width: 45rem;
		margin-top: 1rem;
		color: var(--color-text-muted);
	}
	@media (max-width: 520px) {
		section {
			grid-template-columns: 1fr;
		}
	}
</style>
