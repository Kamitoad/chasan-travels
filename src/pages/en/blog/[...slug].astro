---
import { type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';
import { getVisiblePosts } from '../../../lib/posts';

export async function getStaticPaths() {
	const posts = await getVisiblePosts('en');
	return posts.map((post, index) => ({
		params: { slug: post.id.replace(/^en\//, '') },
		props: { post, entryNumber: index + 1 },
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
	entryNumber: number;
}

const { post, entryNumber } = Astro.props;
const { Content } = await render(post);
const wordCount = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 220));
---

<BlogPost {...post.data} entryNumber={entryNumber} readingMinutes={readingMinutes}>
	<Content />
</BlogPost>
