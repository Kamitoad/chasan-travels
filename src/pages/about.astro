---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
	language?: 'de' | 'en';
}

const { language = 'de' } = Astro.props;
const en = language === 'en';
---

<BaseLayout
	title={en ? 'About me · Chasan Moustafa' : 'Über mich · Chasan Moustafa'}
	description={en
		? 'About Chasan Moustafa and his personal travel stories.'
		: 'Über Chasan Moustafa und seine persönlichen Reisegeschichten.'}
>
	<main id="main-content" class="about">
		<header>
			<p class="eyebrow">{en ? 'About me' : 'Über mich'}</p>
			<h1>{en ? 'Hi, I’m Chasan!' : 'Hi, ich bin Chasan!'}</h1>
		</header>
		<div class="about-grid">
			<p class="lead">
				{
					en
						? 'I love being on the move and trying new things, and I usually have more interests than time. Sometimes I read, cook, code, work out or simply go for a walk.'
						: 'Ich bin gern unterwegs, probiere viel aus und habe meistens mehr Interessen als Zeit. Mal lese ich, koche, programmiere, trainiere oder gehe einfach eine Runde spazieren.'
				}
			</p>
			<div class="body-copy">
				<h2>{en ? 'I’m glad you’re here.' : 'Schön, dass du da bist.'}</h2>
				<p>
					{
						en
							? 'This blog begins with my first international journey to Vancouver. I’m looking forward to meeting new people, trying good food, seeing remarkable landscapes and discovering everything I cannot yet imagine.'
							: 'Dieser Blog beginnt mit meiner ersten internationalen Reise nach Vancouver. Ich freue mich auf neue Menschen, gutes Essen, beeindruckende Natur und auf alles, mit dem ich gerade noch nicht rechne.'
					}
				</p>
				<a href={en ? '/en/blog' : '/blog'}
					>{en ? 'Explore the journal' : 'Zum Journal'} <span aria-hidden="true">→</span></a
				>
			</div>
		</div>
		<aside class="site-note" aria-label={en ? 'About this website' : 'Technik der Website'}>
			<p>
				<strong>{en ? 'A little side note.' : 'Kleine Randnotiz.'}</strong>
				{
					en
						? 'This website is built with Astro. I write the posts in Markdown.'
						: 'Diese Website entsteht mit Astro. Die Beiträge schreibe ich in Markdown.'
				}
			</p>
		</aside>
	</main>
</BaseLayout>

<style>
	.about {
		width: min(calc(100% - 2 * var(--page-gutter)), var(--content-wide));
		margin-inline: auto;
		padding-block: clamp(4rem, 9vw, 8rem);
	}
	header {
		border-bottom: 1px solid var(--color-border);
		padding-bottom: clamp(3rem, 7vw, 6rem);
	}
	h1 {
		max-width: 14ch;
		margin-top: 1.25rem;
		font-size: clamp(3rem, 8vw, 7rem);
		letter-spacing: -0.055em;
		line-height: 0.95;
	}
	.about-grid {
		display: grid;
		grid-template-columns: minmax(16rem, 0.9fr) minmax(18rem, 1.2fr);
		gap: clamp(3rem, 9vw, 9rem);
		padding-block: clamp(3rem, 8vw, 7rem);
	}
	.lead {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.6rem, 3.5vw, 2.7rem);
		line-height: 1.25;
	}
	h2 {
		margin-top: 0;
		font-size: clamp(1.8rem, 3vw, 2.5rem);
	}
	.body-copy p {
		margin-block: 0.8rem 2.75rem;
		color: var(--color-text-muted);
	}
	.body-copy a {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font-weight: 700;
	}
	.site-note {
		border-top: 1px solid var(--color-border);
		padding-top: 1.5rem;
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}
	.site-note p {
		max-width: 48rem;
		margin: 0;
	}
	.site-note strong {
		color: var(--color-text);
		font-family: var(--font-meta);
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	@media (max-width: 700px) {
		.about-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
