---
import PostPreview from '../../components/PostPreview.astro';
import { CURRENT_CHAPTER, SITE_TITLE } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVisiblePosts, type Language } from '../../lib/posts';

interface Props {
	language?: Language;
}

const { language = 'de' } = Astro.props;
const en = language === 'en';
const posts = await getVisiblePosts(language);
---

<BaseLayout
	title={`Journal · ${SITE_TITLE}`}
	description={en
		? 'Stories and notes from Chasan Moustafa’s semester abroad in Vancouver.'
		: 'Alle Geschichten und Notizen aus Chasan Moustafas Auslandssemester in Vancouver.'}
>
	<main id="main-content" class="archive">
		<header>
			<p class="eyebrow">
				{en ? 'Chapter' : 'Kapitel'}
				{CURRENT_CHAPTER.number} · {en ? 'Westward' : CURRENT_CHAPTER.title}
			</p>
			<h1>Journal</h1>
			<p>
				{
					en
						? 'In order: arriving, campus life, the city, nature and all the small moments in between.'
						: 'Chronologisch gesammelt: Ankommen, Campusleben, Stadt, Natur und die kleinen Dinge dazwischen.'
				}
			</p>
		</header>
		{
			posts.length > 0 ? (
				<div class="post-list" aria-label={en ? 'Journal entries' : 'Journal-Einträge'}>
					{posts.map((post, index) => (
						<PostPreview post={post} index={index} language={language} />
					))}
				</div>
			) : (
				<p class="empty-state">
					{en
						? 'It is still quiet here. The first story will arrive soon.'
						: 'Noch ist hier alles ruhig. Der erste Beitrag folgt bald.'}
				</p>
			)
		}
	</main>
</BaseLayout>

<style>
	.archive {
		width: min(calc(100% - 2 * var(--page-gutter)), var(--content-wide));
		margin-inline: auto;
		padding-block: clamp(4rem, 9vw, 8rem);
	}
	header {
		display: grid;
		grid-template-columns: 1fr minmax(16rem, 0.8fr);
		align-items: end;
		gap: 2rem;
		margin-bottom: clamp(4rem, 9vw, 7rem);
	}
	.eyebrow {
		grid-column: 1 / -1;
	}
	h1 {
		font-size: clamp(4rem, 13vw, 9rem);
		letter-spacing: -0.06em;
		line-height: 0.75;
	}
	header > p:last-child,
	.empty-state {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 1.1rem;
	}
	.post-list :global(.post-preview:last-child) {
		border-bottom: 1px solid var(--color-border);
	}
	.empty-state {
		border-block: 1px solid var(--color-border);
		padding-block: 2rem;
	}
	@media (max-width: 700px) {
		header {
			grid-template-columns: 1fr;
		}
	}
</style>
