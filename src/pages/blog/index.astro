---
import PostPreview from '../../components/PostPreview.astro';
import { CURRENT_CHAPTER, SITE_TITLE } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVisiblePosts } from '../../lib/posts';

const posts = await getVisiblePosts();
---

<BaseLayout
	title={`Journal · ${SITE_TITLE}`}
	description="Alle Geschichten und Notizen aus Chasan Moustafas Auslandssemester in Vancouver."
>
	<main id="main-content" class="archive">
		<header>
			<p class="eyebrow">Kapitel {CURRENT_CHAPTER.number} · {CURRENT_CHAPTER.title}</p>
			<h1>Journal</h1>
			<p>
				Chronologisch gesammelt: Ankommen, Campusleben, Stadt, Natur und die kleinen Dinge
				dazwischen.
			</p>
		</header>
		{
			posts.length > 0 ? (
				<div class="post-list" aria-label="Journal-Einträge">
					{posts.map((post, index) => (
						<PostPreview post={post} index={index} />
					))}
				</div>
			) : (
				<p class="empty-state">Noch ist hier alles ruhig. Der erste Beitrag folgt bald.</p>
			)
		}
	</main>
</BaseLayout>

<style>
	.archive {
		width: min(calc(100% - 2 * var(--page-gutter)), var(--content-wide));
		margin-inline: auto;
		padding-block: clamp(4rem, 9vw, 8rem);
	}
	header {
		display: grid;
		grid-template-columns: 1fr minmax(16rem, 0.8fr);
		align-items: end;
		gap: 2rem;
		margin-bottom: clamp(4rem, 9vw, 7rem);
	}
	.eyebrow {
		grid-column: 1 / -1;
	}
	h1 {
		font-size: clamp(4rem, 13vw, 9rem);
		letter-spacing: -0.06em;
		line-height: 0.75;
	}
	header > p:last-child,
	.empty-state {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 1.1rem;
	}
	.post-list :global(.post-preview:last-child) {
		border-bottom: 1px solid var(--color-border);
	}
	.empty-state {
		border-block: 1px solid var(--color-border);
		padding-block: 2rem;
	}
	@media (max-width: 700px) {
		header {
			grid-template-columns: 1fr;
		}
	}
</style>
